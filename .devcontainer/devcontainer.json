{
  "name": "test-app",
  "dockerComposeFile": [
    "../infra/docker-compose.local.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "ms-playwright.playwright",
        "redhat.vscode-yaml",
        "GitHub.copilot"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/current",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "forwardPorts": [5173, 8080, 3306, 5000],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)", "onAutoForward": "openBrowser" },
    "8080": { "label": "Backend (Spring Boot)" },
    "3306": { "label": "MySQL" },
    "5000": { "label": "Moto S3" }
  },

  "postCreateCommand": "cd /workspace/frontend && npm ci && npx playwright install --with-deps chromium",
  "remoteUser": "vscode"
}
