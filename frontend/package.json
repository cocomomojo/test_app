{
  "name": "test-app-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview",
    "setup:e2e": "playwright install --with-deps chromium",
    "test": "npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "npm run test:e2e && npm run coverage:report",
    "coverage:report": "nyc report --reporter=html --reporter=lcov --reporter=text --temp-dir=coverage/e2e-raw --report-dir=coverage/e2e-report"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "vue": "^3.5.41",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^3.2.3",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "flush-promises": "^1.0.2",
    "jsdom": "^26.1.0",
    "nyc": "^17.1.0",
    "sass": "^1.88.0",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^6.3.5",
    "vite-plugin-istanbul": "^6.0.2",
    "vitest": "^3.2.3",
    "vuetify": "^3.8.5"
  }
}
