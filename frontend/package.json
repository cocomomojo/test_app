{
  "name": "test-app-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview",
    "setup:e2e": "playwright install --with-deps chromium",
    "test": "npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "npm run test:e2e && npm run coverage:report",
    "coverage:report": "nyc report --reporter=html --reporter=lcov --reporter=text --temp-dir=coverage/e2e-raw --report-dir=coverage/e2e-report"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.5.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.0",
    "flush-promises": "^1.0.2",
    "jsdom": "^30.0.1",
    "nyc": "^18.0.0",
    "sass": "^1.104.0",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.0",
    "vuetify": "^4.2.1"
  }
}
