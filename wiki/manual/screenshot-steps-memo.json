{
  "feature": "メモ機能",
  "manualType": "user",
  "steps": [
    {
      "stepNumber": 1,
      "filename": "01-memo-login-initial.png",
      "description": "ログイン画面（未ログイン時）",
      "actions": [
        { "type": "navigate", "target": "http://localhost:5173", "description": "ログイン画面に移動" }
      ]
    },
    {
      "stepNumber": 2,
      "filename": "02-memo-login-with-userid.png",
      "description": "ユーザーID入力後",
      "actions": [
        { "type": "fill", "target": "最初の入力フィールド", "value": "testuser", "description": "ユーザーIDを入力" }
      ]
    },
    {
      "stepNumber": 3,
      "filename": "03-memo-login-with-password.png",
      "description": "パスワード入力後",
      "actions": [
        { "type": "fill", "target": "パスワード入力フィールド", "value": "Test1234!", "description": "パスワードを入力" }
      ]
    },
    {
      "stepNumber": 4,
      "filename": "04-memo-login-click.png",
      "description": "ログイン実行（クリック後待機）",
      "actions": [
        { "type": "click", "target": "「ログイン」", "description": "ログインボタンをクリック" },
        { "type": "wait", "duration": 1500, "description": "ログイン処理待機" }
      ]
    },
    {
      "stepNumber": 5,
      "filename": "05-memo-page-initial.png",
      "description": "メモページ（初期状態）",
      "actions": [
        { "type": "navigate_to_path", "target": "/memo", "description": "/memo に遷移" },
        { "type": "wait", "duration": 1000, "description": "表示待機" }
      ]
    },
    {
      "stepNumber": 6,
      "filename": "06-memo-entry-typed.png",
      "description": "メモ入力（タイトル欄想定）",
      "actions": [
        { "type": "fill", "target": "最初の入力フィールド", "value": "会議メモ", "description": "タイトル相当を入力" },
        { "type": "wait", "duration": 500, "description": "入力反映待機" }
      ]
    },
    {
      "stepNumber": 7,
      "filename": "07-memo-save-clicked.png",
      "description": "保存（または追加）操作後",
      "actions": [
        { "type": "click", "target": "「保存」ボタン", "description": "保存ボタンをクリック（存在すれば）" },
        { "type": "wait", "duration": 1500, "description": "保存処理待機" }
      ]
    },
    {
      "stepNumber": 8,
      "filename": "08-memo-list-after.png",
      "description": "保存後の一覧（または入力後状態）",
      "actions": [
        { "type": "wait", "duration": 500, "description": "表示安定化" }
      ]
    }
  ]
}
